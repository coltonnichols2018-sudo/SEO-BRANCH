    <ul>
      <li><a href="https://www.facebook.com/Bubbasmattressfurniturelouisville/" rel="noopener" target="_blank" itemprop="sameAs">Facebook</a></li>
      <li><a href="https://www.instagram.com/bubbasfurnitureandmattress/" rel="noopener" target="_blank" itemprop="sameAs">Instagram</a></li>
    </ul>
  </div>

  <meta itemprop="url" content="https://www.bubbasmattressfurniturelouisville.com/">
