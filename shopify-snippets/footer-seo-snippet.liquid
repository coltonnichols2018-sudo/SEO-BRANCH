{% comment %}
  ============================================================
  SEO-OPTIMIZED FOOTER SNIPPET FOR SHOPIFY
  ============================================================

  HOW TO INSTALL:
  1. Go to Shopify Admin > Online Store > Themes
  2. Click "Actions" > "Edit Code"
  3. Under "Snippets", click "Add a new snippet"
  4. Name it "footer-seo"
  5. Paste this content
  6. Add {% render 'footer-seo' %} to your footer.liquid section
  ============================================================
{% endcomment %}

<div class="footer-seo" itemscope itemtype="https://schema.org/FurnitureStore">
  <div class="footer-seo__info">
    <h3 itemprop="name">Bubba's Mattress & Furniture</h3>
    <p itemprop="description">Louisville's Ashley Furniture Destination</p>

    <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
      <p>
        <span itemprop="streetAddress">5907 Terry Road</span><br>
        <span itemprop="addressLocality">Louisville</span>,
        <span itemprop="addressRegion">KY</span>
        <span itemprop="postalCode">40216</span>
      </p>
    </div>

    <p>
      <a href="tel:+15024940376" itemprop="telephone">(502) 494-0376</a>
      <br><small>Call or Text</small>
    </p>
  </div>

  <div class="footer-seo__hours">
    <h4>Store Hours</h4>
    <table>
      <tr><td>Monday</td><td>11:30 AM - 6:30 PM</td></tr>
      <tr><td>Tuesday</td><td>11:30 AM - 6:30 PM</td></tr>
      <tr><td>Wednesday</td><td>11:30 AM - 6:30 PM</td></tr>
      <tr><td>Thursday</td><td>11:30 AM - 5:00 PM</td></tr>
