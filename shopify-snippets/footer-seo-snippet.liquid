      <tr><td>Saturday</td><td>11:30 AM - 6:00 PM</td></tr>
      <tr><td>Sunday</td><td>Closed</td></tr>
    </table>
  </div>

  <div class="footer-seo__areas">
    <h4>Serving Louisville & Surrounding Areas</h4>
    <p>
      Valley Station, Pleasure Ridge Park, Shively, Okolona,
      Fairdale, West Louisville, South Louisville, Downtown Louisville,
      Jeffersontown, Shepherdsville, Radcliff, Elizabethtown,
      New Albany IN, Clarksville IN
    </p>
  </div>

  <div class="footer-seo__links">
    <h4>Shop Categories</h4>
    <ul>
      <li><a href="/collections/mattresses">Mattresses</a></li>
      <li><a href="/collections/living-room-recliners">Recliners</a></li>
      <li><a href="/collections/living-room-sofas">Sofas & Sectionals</a></li>
      <li><a href="/collections/bedroom">Bedroom Furniture</a></li>
      <li><a href="/collections/dining-room">Dining Room</a></li>
