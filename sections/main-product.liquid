<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                </div>
                {%- assign monthly = product.selected_or_first_available_variant.price | divided_by: 2400 -%}
                {%- if monthly > 0 -%}
                <p style="margin:6px 0 0;font-size:13px;color:#555;">
                  or ~${{ monthly }}/mo with <a href="/pages/financing" style="color:#555;text-decoration:underline;">financing</a>
                </p>
                {%- endif -%}
                <div class="bubba-product-info">
                

                  <!-- Delivery & Pickup Info -->
<div style="font-family:'Jost', sans-serif;margin:16px 0;border-top:1px solid #e8e8e8;padding-top:16px;">
  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
    <span style="font-size:14px;">🚚</span>
    <div>
      <span style="font-size:14px;color:#111111;font-weight:500;">Order today — delivered in 1–2 weeks</span>
      <span style="font-size:13px;color:#777777;"> · Within 50 miles of Louisville · <a href="/pages/delivery-and-pickup-information" style="color:#777777;text-decoration:underline;">Details</a></span>
    </div>
  </div>
  <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;">
    <span style="font-size:14px;">💳</span>
    <div>
      <span style="font-size:14px;color:#111111;font-weight:500;">$40 down — no credit check needed</span>
      <span style="font-size:13px;color:#777777;"> · Flexible financing available · <a href="/pages/financing" style="color:#777777;text-decoration:underline;">Learn more</a></span>
    </div>
  </div>
  <div style="display:flex;align-items:flex-start;gap:8px;">
    <span style="font-size:14px;">📞</span>
    <div>
      <span style="font-size:14px;color:#111111;font-weight:500;">Questions?</span>
      <span style="font-size:13px;color:#777777;"> Call or text Colton · <a href="tel:5024940376" style="color:#777777;text-decoration:underline;">(502) 494-0376</a></span>
    </div>
  </div>
</div>
</div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}
                      {{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {%- endform -%}
                </div>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
             {%- when 'description' -%}
  {%- assign has_hr = false -%}
  {%- if product.description contains '<hr' -%}
    {%- assign has_hr = true -%}
  {%- endif -%}

  {%- comment -%} Product info accordion dropdowns {%- endcomment -%}
  <style>
    .product-accordion { margin: 24px 0 20px; }
    .product-accordion details {
      border-bottom: 1px solid #e0e0e0;
    }
    .product-accordion details:first-child {
      border-top: 1px solid #e0e0e0;
    }
    .product-accordion summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 4px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      color: #111;
      list-style: none;
      user-select: none;
    }
    .product-accordion summary::-webkit-details-marker { display: none; }
    .product-accordion summary::after {
      content: '+';
      font-size: 20px;
      font-weight: 300;
      color: #666;
      transition: transform 0.2s ease;
    }
    .product-accordion details[open] summary::after {
      content: '−';
    }
    .product-accordion .accordion-content {
      padding: 0 4px 24px;
      line-height: 1.7;
      font-size: 0.95em;
      color: #333;
    }
    /* Variant cards in Dimensions dropdown */
    .variant-cards { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .variant-card {
      padding: 14px 16px;
      background: #fafafa;
      border: 1px solid #eee;
      border-radius: 6px;
    }
    .variant-card__name { font-weight: 600; font-size: 0.95em; margin-bottom: 6px; color: #111; }
    .variant-card__details { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.85em; color: #555; }

    /* Details list rows */
    .details-list { display: flex; flex-direction: column; }
    .details-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
      font-size: 0.9em;
    }
    .details-row:last-child { border-bottom: none; }
    .details-label { font-weight: 600; color: #111; min-width: 100px; }

    /* Dims CTA box */
    .product-accordion .dims-cta {
      margin-top: 20px;
      padding: 20px;
      background: #fafafa;
      border: 1px solid #eee;
      border-radius: 6px;
      line-height: 1.6;
    }
    .product-accordion .dims-cta p { margin: 0; }
    .product-accordion .dims-cta a { color: #111; font-weight: 600; }

    /* Tables injected by JS (hardcoded dimensions) */
    .product-accordion table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9em;
      margin-bottom: 8px;
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .product-accordion th,
    .product-accordion td {
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid #eee;
      white-space: nowrap;
    }
    .product-accordion th {
      font-weight: 600;
      font-size: 0.8em;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #555;
      background: #fafafa;
    }
    .product-accordion tr:last-child td { border-bottom: none; }

    @media screen and (max-width: 749px) {
      .product-accordion summary { padding: 14px 2px; font-size: 13px; }
      .product-accordion .accordion-content { padding: 0 2px 20px; }
      .details-row { flex-direction: column; align-items: flex-start; gap: 2px; }
      .variant-card { padding: 12px; }
      .variant-card__details { gap: 8px; font-size: 0.8em; }
    }
  </style>

  <div class="product-accordion quick-add-hidden" {{ block.shopify_attributes }}>

    {%- comment -%} === OVERVIEW === {%- endcomment -%}
    <details open>
      <summary>Overview</summary>
      <div class="accordion-content rte">
        {%- if has_hr -%}
          {{ product.description | split: '<hr' | first }}
        {%- else -%}
          {{ product.description }}
        {%- endif -%}
      </div>
    </details>

    {%- comment -%} === DIMENSIONS === {%- endcomment -%}
    <details id="accordion-dimensions">
      <summary>Dimensions</summary>
      <div class="accordion-content" id="tab-dimensions">
        {%- if has_hr -%}
          <div class="rte" style="line-height:1.8;">
            {{ product.description | split: '<hr' | last }}
          </div>
        {%- else -%}
          {%- if product.variants.size > 1 -%}
            <div class="variant-cards">
              {%- for variant in product.variants -%}
                <div class="variant-card">
                  <div class="variant-card__name">{{ variant.title }}</div>
                  <div class="variant-card__details">
                    {%- if variant.sku != blank -%}<span>SKU: {{ variant.sku }}</span>{%- endif -%}
                    <span>{{ variant.price | money }}</span>
                    <span>{%- if variant.available -%}<span style="color:#2e7d32;">In Stock</span>{%- else -%}<span style="color:#999;">Sold Out</span>{%- endif -%}</span>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="dims-cta">
          <p style="font-size:0.9em; color:#555;">
            Want measurements for a specific piece? Text Colton at <a href="tel:+15024940376" style="font-weight:600;">(502) 494-0376</a> and we'll get them to you.
          </p>
        </div>
      </div>
    </details>

    {%- comment -%} === DETAILS === {%- endcomment -%}
    <details>
      <summary>Details</summary>
      <div class="accordion-content">
        <div class="details-list">
          {%- if product.vendor != blank -%}
            <div class="details-row"><span class="details-label">Brand</span><span>{{ product.vendor }}</span></div>
          {%- endif -%}
          {%- if product.type != blank -%}
            <div class="details-row"><span class="details-label">Type</span><span>{{ product.type }}</span></div>
          {%- endif -%}
          {%- if product.selected_or_first_available_variant.sku != blank -%}
            <div class="details-row"><span class="details-label">SKU</span><span>{{ product.selected_or_first_available_variant.sku }}</span></div>
          {%- endif -%}
          {%- if product.selected_or_first_available_variant.weight > 0 -%}
            <div class="details-row"><span class="details-label">Weight</span><span>{{ product.selected_or_first_available_variant.weight | weight_with_unit: product.selected_or_first_available_variant.weight_unit }}</span></div>
          {%- endif -%}
          <div class="details-row"><span class="details-label">Availability</span><span>{%- if product.available -%}<span style="color:#2e7d32; font-weight:500;">&#10003; In Stock</span>{%- else -%}<span style="color:#c62828;">Currently Unavailable</span>{%- endif -%}</span></div>
          <div class="details-row"><span class="details-label">Financing</span><span>$40 down, no credit check — <a href="/pages/financing" style="text-decoration:underline;">Apply now</a></span></div>
          <div class="details-row"><span class="details-label">Delivery</span><span>1–2 weeks, within 50 miles — <a href="/pages/delivery" style="text-decoration:underline;">Learn more</a></span></div>
          <div class="details-row"><span class="details-label">Warranty</span><span>Manufacturer warranty included</span></div>
        </div>
      </div>
    </details>

  </div>

  <script>
  (function(){
    var t=document.getElementById('tab-dimensions');
    var ov=document.querySelector('.accordion-content.rte');
    if(!t||!ov)return;

    /* Hardcoded dimensions for specific products */
    var dims={
      'ophannon-sectional':'<h3 style="margin:0 0 16px;font-size:1em;font-weight:600">O\'Phannon Sectional</h3><table><thead><tr><th>Piece</th><th>Width</th><th>Depth</th><th>Height</th><th>Weight</th></tr></thead><tbody><tr><td><b>Overall</b></td><td>125"</td><td>86"</td><td>38"</td><td>260 lbs</td></tr><tr><td><b>LAF Sofa Chaise</b></td><td>87"</td><td>61"</td><td>38"</td><td>147 lbs</td></tr><tr><td><b>RAF Corner Chaise</b></td><td>37"</td><td>86"</td><td>38"</td><td>113 lbs</td></tr></tbody></table><p style="margin:16px 0 0;font-size:.9em"><b>Additional:</b> Seat Depth: 23" · Seat Height: 21" · Arm Height: 26"</p>',
      'rawcliffe':'<h3 style="margin:0 0 16px;font-size:1em;font-weight:600">Rawcliffe Sectional</h3><table><thead><tr><th>Piece</th><th>Width</th><th>Depth</th><th>Height</th><th>Weight</th></tr></thead><tbody><tr><td><b>LAF Sofa</b></td><td>86"</td><td>44"</td><td>38"</td><td>135 lbs</td></tr><tr><td><b>Wedge</b></td><td>45"</td><td>44"</td><td>38"</td><td>83 lbs</td></tr><tr><td><b>Armless Chair</b></td><td>39"</td><td>44"</td><td>38"</td><td>70 lbs</td></tr><tr><td><b>RAF Sofa</b></td><td>86"</td><td>44"</td><td>38"</td><td>135 lbs</td></tr></tbody></table>',
      'barrelton':'<h3 style="margin:0 0 16px;font-size:1em;font-weight:600">Barrelton Sectional</h3><table><thead><tr><th>Piece</th><th>Width</th><th>Depth</th><th>Height</th><th>Weight</th></tr></thead><tbody><tr><td><b>Corner Chair</b></td><td>41"</td><td>41"</td><td>37"</td><td>75 lbs</td></tr><tr><td><b>Armless Chair</b></td><td>30"</td><td>41"</td><td>37"</td><td>58 lbs</td></tr><tr><td><b>Corner Chaise</b></td><td>41"</td><td>64"</td><td>37"</td><td>92 lbs</td></tr></tbody></table>'
    };
    var m=window.location.pathname.match(/\/products\/([^/?#]+)/);
    if(m){
      var h=m[1].toLowerCase(),hd=dims[h];
      if(!hd){for(var k in dims){if(h.indexOf(k)>-1||k.indexOf(h)>-1){hd=dims[k];break;}}}
      if(hd){
        var vc=t.querySelector('.variant-cards');
        if(vc){t.insertBefore(Object.assign(document.createElement('div'),{innerHTML:hd}),vc);vc.style.display='none';}
        else{var ct=t.querySelector('.dims-cta');if(ct)ct.insertAdjacentHTML('beforebegin',hd);else t.insertAdjacentHTML('afterbegin',hd);}
        document.getElementById('accordion-dimensions').setAttribute('open','');
        return;
      }
    }

    /* Auto-extract: split description into overview vs dimensions */
    var html=ov.innerHTML;
    var tmp=document.createElement('div');
    tmp.innerHTML=html;
    var overviewParts=[];
    var dimParts=[];
    var kw=/\d+[\.\d]*\s*(lb|lbs|pound|kg)|(\d+[\.\d]*\s*")|(\d+[\.\d]*\s*in\b)|\bwidth\b|\bdepth\b|\bheight\b|\bweight\b|\bdimension/i;
    var nodes=tmp.childNodes;
    for(var i=0;i<nodes.length;i++){
      var n=nodes[i];
      if(kw.test(n.textContent||'')){
        dimParts.push(n.outerHTML||n.textContent);
      } else {
        overviewParts.push(n.outerHTML||n.textContent);
      }
    }

    if(dimParts.length>0){
      ov.innerHTML=overviewParts.join('');

      /* Wrap each dimension block with data attributes for variant filtering */
      var dimContainer=document.createElement('div');
      dimContainer.id='dims-all-variants';
      dimContainer.innerHTML=dimParts.join('');

      /* Tag each block-level child with the variant name it contains */
      var blocks=dimContainer.querySelectorAll(':scope > *');
      blocks.forEach(function(block){
        block.setAttribute('data-dim-block','true');
      });

      var vc2=t.querySelector('.variant-cards');
      if(vc2){t.insertBefore(dimContainer,vc2);vc2.style.display='none';}
      else{var ct2=t.querySelector('.dims-cta');if(ct2)t.insertBefore(dimContainer,ct2);else t.insertBefore(dimContainer,t.firstChild);}
      document.getElementById('accordion-dimensions').setAttribute('open','');

      /* Listen for variant changes and filter dimensions */
      function filterDimsByVariant(variantTitle){
        if(!variantTitle)return;
        var vt=variantTitle.toLowerCase();
        var allBlocks=dimContainer.querySelectorAll('[data-dim-block]');
        var anyMatch=false;

        /* First pass: check if any blocks match the variant title */
        allBlocks.forEach(function(b){
          var txt=b.textContent.toLowerCase();
          /* Check if this block's text contains words from the variant title */
          var words=vt.replace(/[^a-z0-9\s]/g,'').split(/\s+/).filter(function(w){return w.length>2;});
          var matches=words.filter(function(w){return txt.indexOf(w)>-1;});
          if(matches.length>=2){anyMatch=true;}
        });

        if(!anyMatch){
          /* No matches found — show everything (don't hide anything) */
          allBlocks.forEach(function(b){b.style.display='';});
          return;
        }

        /* Second pass: show only matching blocks */
        allBlocks.forEach(function(b){
          var txt=b.textContent.toLowerCase();
          var words=vt.replace(/[^a-z0-9\s]/g,'').split(/\s+/).filter(function(w){return w.length>2;});
          var matches=words.filter(function(w){return txt.indexOf(w)>-1;});
          b.style.display=(matches.length>=2)?'':'none';
        });
      }

      /* Subscribe to Shopify's variant change event */
      if(window.subscribe && window.PUB_SUB_EVENTS){
        subscribe(PUB_SUB_EVENTS.variantChange,function(evt){
          if(evt.data&&evt.data.variant){
            filterDimsByVariant(evt.data.variant.title||evt.data.variant.public_title||'');
          }
        });
      }

      /* Also filter on initial load based on selected variant */
      var selected=document.querySelector('variant-selects input[type="radio"]:checked, variant-selects select');
      if(selected){
        var initialTitle=selected.value||selected.textContent||'';
        if(initialTitle)filterDimsByVariant(initialTitle);
      }
    }
  })();
  </script>
