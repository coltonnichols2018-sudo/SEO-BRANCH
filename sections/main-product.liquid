  .sticky-atc__title{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;}
  .sticky-atc__price{font-size:13px;margin:2px 0 0;opacity:0.8;}
  .sticky-atc__btn{
    background:#111;color:#fff;border:none;padding:12px 20px;
    border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;
    white-space:nowrap;flex-shrink:0;
  }
  .text-colton-btn{bottom:70px !important;}
}
</style>
<div class="sticky-atc">
  <div class="sticky-atc__info">
    <p class="sticky-atc__title">{{ product.title | escape }}</p>
    <p class="sticky-atc__price">{{ product.selected_or_first_available_variant.price | money }}</p>
  </div>
  {%- if product.available -%}
  <button class="sticky-atc__btn" onclick="document.querySelector('.product-form__submit, [name=add]').click()">
    Add to Cart
  </button>
  {%- else -%}
  <a href="tel:+15024940376" class="sticky-atc__btn" style="text-decoration:none;color:#fff;">
    Call for Availability
  </a>
  {%- endif -%}
</div>

