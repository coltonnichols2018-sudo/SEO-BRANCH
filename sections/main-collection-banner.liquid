{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}

      {%- comment -%} SEO intro content per collection {%- endcomment -%}
      {%- assign ch = collection.handle -%}
      {%- if ch == 'mattresses' or ch == 'sleep-bedding' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Shop quality mattresses in Louisville, KY at Bubba's. We carry Sierra Sleep by Ashley, Tempur-Pedic, Stearns & Foster, and more — in twin, full, queen, king, and California king sizes. Memory foam, hybrid, and innerspring options available. Lease-to-own and credit options available.</p>
      {%- elsif ch == 'bedroom' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Complete bedroom sets and individual pieces from Ashley Furniture in Louisville, KY. Beds, dressers, nightstands, chests, and headboards in queen and king sizes. Brand new with full warranty, lease-to-own and credit options available, and local delivery within 50 miles.</p>
      {%- elsif ch == 'living-room' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Browse our full Ashley Furniture living room collection in Louisville, KY — sectionals, sofas, recliners, ottomans, and accent pieces. All brand new with manufacturer warranty. Lease-to-own and credit options available.</p>
      {%- elsif ch == 'living-room-recliners' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Power recliners, manual recliners, and lift chairs from Ashley Furniture in Louisville, KY. Single recliners, reclining loveseats, and full reclining sofas. Try them in our showroom at 5907 Terry Rd. Lease-to-own and credit options available.</p>
      {%- elsif ch == 'living-room-sectionals' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Modular sectionals, reclining sectionals, sleeper sectionals, and chaise sectionals from Ashley Furniture in Louisville, KY. Choose from 2-piece up to 6-piece configurations. Brand new, warrantied, with lease-to-own and credit options available.</p>
      {%- elsif ch == 'dining-room' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Dining room sets, tables, chairs, bar stools, and counter-height sets from Ashley Furniture in Louisville, KY. 5-piece, 7-piece, and 9-piece dining sets available. Lease-to-own and credit options available.</p>
      {%- elsif ch == 'kids-teens' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Kids beds, bunk beds, twin beds, and teen bedroom furniture in Louisville, KY. Ashley Furniture quality at affordable prices. Lease-to-own and credit options available.</p>
      {%- elsif ch == 'outdoor' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Outdoor patio furniture, fire pits, and outdoor seating in Louisville, KY. Ashley Furniture outdoor collection — built to handle Kentucky weather. Local delivery within 50 miles.</p>
      {%- elsif ch == 'home-office' -%}
        <p style="line-height:1.7;margin:12px 0 0;max-width:720px;">Home office desks, office chairs, bookcases, and storage in Louisville, KY. Ashley Furniture home office collection with lease-to-own and credit options available.</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | default: collection.title | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
