<section
  class="custom-carousel-wrapper {{ section.settings.padding_top }} {{ section.settings.padding_bottom }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <h2 class="carousel-title {{ section.settings.title_size }}" style="color: {{ section.settings.title_color }};">
    {{ section.settings.carousel_title }}
  </h2>

  <div class="carousel-outer">
    <button class="carousel-arrow left" onclick="scrollCarousel(this, -1)" aria-label="Previous slide">&#10094;</button>

    <div class="carousel-container" id="carousel-{{ section.id }}">
      {% for i in (1..15) %}
        {% capture image_key %}image_{{ i }}{% endcapture %}
        {% assign image = section.settings[image_key] %}
        {% if image %}
          <div class="carousel-slide">
            <img
              src="{{ image | image_url: width: 1200 }}"
              srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              alt="{{ section.settings.carousel_title | default: 'Featured' }} - Image {{ i }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            />
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button class="carousel-arrow right" onclick="scrollCarousel(this, 1)" aria-label="Next slide">&#10095;</button>
  </div>
</section>

<style>
  .custom-carousel-wrapper {
    position: relative;
    text-align: left;
  }

  .pt-none { padding-top: 0 !important; }
  .pt-small { padding-top: 5px; }
  .pt-medium { padding-top: 20px; }
  .pt-large { padding-top: 40px; }

  .pb-none { padding-bottom: 0 !important; }
  .pb-small { padding-bottom: 10px; }
  .pb-medium { padding-bottom: 20px; }
  .pb-large { padding-bottom: 40px; }

  .carousel-title {
    margin-bottom: 20px;
    margin-left: 45px;
    letter-spacing: 0.5px;
  }

  .carousel-title.small {
    font-size: 3rem;
  }

  .carousel-title.medium {
    font-size: 3.25rem;
  }

  .carousel-title.large {
    font-size: 4.75rem;
  }

  .carousel-outer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-container {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 10px 10px;
  }

  .carousel-slide {
    flex: 0 0 auto;
    scroll-snap-align: center;
    width: 350px;
    height: 350px;
    overflow: hidden;
    border-radius: 0px;
  }
  
  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0px;
  }

  .carousel-arrow {
    background: none;
    border: none;
    color: black;
    font-size: 20px;
    min-width: 44px;
    min-height: 44px;
    padding: 10px 15px;
    cursor: pointer;
    z-index: 10;
    transition: background 0.3s;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-container { scroll-behavior: auto; }
  }

  .carousel-arrow:hover {
    background: none;
  }

  .carousel-arrow.left {
    margin-right: 20px;
  }

  .carousel-arrow.right {
    margin-left: 20px;
  }

  .carousel-container::-webkit-scrollbar {
    display: none;
  }

  .carousel-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media (max-width: 300px) {
    .carousel-slide {
      width: 100px;
      height: 100px;
    }

    .carousel-arrow {
      font-size: 24px;
      padding: 8px 12px;
    }
  }
</style>

<script>
  function scrollCarousel(btn, direction) {
    const container = btn.closest('.carousel-outer').querySelector('.carousel-container');
    const slide = container.querySelector('.carousel-slide');
    if (slide) {
      const scrollAmount = slide.offsetWidth + 20;
      container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const carousels = document.querySelectorAll(".carousel-container");

    carousels.forEach(function (carousel) {
      let autoplay;

      const startAutoplay = () => {
        autoplay = setInterval(() => {
          const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;
          const nearEnd = carousel.scrollLeft + 5 >= maxScrollLeft;

          if (nearEnd) {
            carousel.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            carousel.scrollBy({ left: 270, behavior: 'smooth' });
          }
        }, 3000);
      };

      const stopAutoplay = () => clearInterval(autoplay);

      // Only add hover listeners on devices with a mouse
      if (window.matchMedia('(hover: hover)').matches) {
        carousel.addEventListener('mouseenter', stopAutoplay);
        carousel.addEventListener('mouseleave', startAutoplay);
      }

      startAutoplay(); // Start autoplay on all devices
    });
  });
</script>

