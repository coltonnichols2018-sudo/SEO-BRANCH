ption": false, "description_style": "body", "columns_desktop": 4, "enable_desktop_slider": true, "full_width": false, "show_view_all": true, "view_all_style": "solid", "color_scheme": "scheme-1", "image_ratio": "adapt", "image_shape": "default", "show_secondary_image": true, "show_vendor": false, "show_rating": true, "quick_add": "none", "columns_mobile": "2", "swipe_on_mobile": true, "padding_top": 16, "padding_bottom": 16}}, "featured_collection_gYVNrD": {"type": "featured-collection", "settings": {"collection": "mattresses", "products_to_show": 8, "title": "Shop Mattresses", "heading_size": "h2", "description": "", "show_description": false, "description_style": "body", "columns_desktop": 4, "enable_desktop_slider": true, "full_width": false, "show_view_all": true, "view_all_style": "solid", "color_scheme": "scheme-1", "image_ratio": "adapt", "image_shape": "default", "show_secondary_image": true, "show_vendor": false, "show_rating": true, "quick_add": "none", "columns_mobile": "2", "swipe_on_mobile": true, "padding_top": 16, "padding_bottom": 16}}, "17743841608bd9bb61": {"type": "apps", "blocks": {"judge_me_reviews_featured_carousel_bMrLhH": {"type": "shopify://apps/judge-me-reviews/blocks/featured_carousel/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8", "settings": {"maxwidth": 1080}}}, "block_order": ["judge_me_reviews_featured_carousel_bMrLhH"], "settings": {"include_margins": true}}, "rich_text_3VLD8a": {"type": "rich-text", "blocks": {"heading_86FR4L": {"type": "heading", "settings": {"heading": "Bubba's Mattress & Furniture", "heading_size": "h2"}}, "text_YN47KF": {"type": "text", "settings": {"text": "<p>Bubba\u2019s Mattress & Furniture is Louisville's #1 Ashley Furniture destination. Locally owned and operated by Colton Nichols since 2021, we carry the full Ashley Furniture lineup \u2014 sectionals, bedroom sets, dining rooms and mattresses \u2014 all brand new and delivered to your door within 50 miles of Louisville in 1\u20132 weeks. We believe everyone deserves a home they're proud of, which is why we offer lease-to-own and credit options for every budget. 285 five-star Google reviews and counting. Call or text Colton personally at (502) 494-0376.</p>"}}, "button_kqWnqX": {"type": "button", "settings": {"button_label": "About Us", "button_link": "shopify://pages/about-us", "button_style_secondary": false, "button_label_2": "", "button_link_2": "", "button_style_secondary_2": false}}}, "block_order": ["heading_86FR4L", "text_YN47KF", "button_kqWnqX"], "settings": {"desktop_content_position": "center", "content_alignment": "center", "color_scheme": "scheme-5", "full_width": true, "padding_top": 40, "padding_bottom": 52}}, "custom_liquid_LEWWWT": {"type": "custom-liquid", "name": "t:sections.custom-liquid.presets.name", "settings": {"custom_liquid": "<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3136.8846223426276!2d-85.8666865!3d38.166120899999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88691501cfe0428b%3A0xf0697f17b1074278!2sBubba&#39;s%20Mattress%20and%20Furniture!5e0!3m2!1sen!2sus!4v1756393883295!5m2!1sen!2sus\" width=\"100%\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"FurnitureStore\",\"name\":\"Bubba's Mattress & Furniture\",\"image\":\"https://www.bubbasmattressfurniturelouisville.com/cdn/shop/files/Screenshot_2024-08-11_120852.png\",\"url\":\"https://www.bubbasmattressfurniturelouisville.com\",\"telephone\":\"(502) 494-0376\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"5907 Terry Rd\",\"addressLocality\":\"Louisville\",\"addressRegion\":\"KY\",\"postalCode\":\"40258\",\"addressCountry\":\"US\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":38.1661,\"longitude\":-85.8667},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\"],\"opens\":\"11:30\",\"closes\":\"18:30\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Thursday\",\"opens\":\"11:30\",\"closes\":\"17:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Friday\",\"opens\":\"11:30\",\"closes\":\"18:30\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Saturday\",\"opens\":\"11:30\",\"closes\":\"18:00\"}],\"priceRange\":\"$$\",\"areaServed\":[\"Louisville\",\"Shively\",\"Valley Station\",\"Pleasure Ridge Park\",\"Okolona\"],\"description\":\"Affordable Ashley Furniture store in Louisville, KY. Lease-to-own and credit options available. Mattresses, bedroom sets, sofas, dining sets and more. Local delivery within 50 miles.\",\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"5.0\",\"reviewCount\":\"287\"},\"sameAs\":[\"https://www.facebook.com/Bubbasmattressfurniturelouisville/\"]}\n</script>", "color_scheme": "", "padding_top": 0, "padding_bottom": 0}}, "custom_liquid_NnTykD": {"type": "custom-liquid", "name": "t:sections.custom-liquid.presets.name", "settings": {"custom_liquid": "<div style=\"max-width:850px;margin:0 auto;padding:32px 20px;\">\n\n<h2 style=\"font-size:1.6em;line-height:1.3;margin:0 0 20px;text-align:center;\">Louisville's Authorized Ashley Furniture Dealer</h2>\n\n<p style=\"font-size:1.05em;line-height:1.7;margin:0 0 24px;text-align:center;color:#444;\">Quality furniture, mattresses, and bedroom sets \u2014 with financing for every budget. Locally owned in Louisville, KY since 2021.</p>\n\n<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;margin:32px 0;\">\n  <div style=\"text-align:center;padding:20px;border:1px solid #eee;border-radius:6px;\">\n    <p style=\"font-weight:600;margin:0 0 8px;font-size:1.05em;\">Wide Selection</p>\n    <p style=\"margin:0;font-size:0.9em;opacity:0.7;line-height:1.6;\">Full Ashley Furniture catalog \u2014 sectionals, sofas, bedroom sets, mattresses, dining, recliners, and more.</p>\n  </div>\n  <div style=\"text-align:center;padding:20px;border:1px solid #eee;border-radius:6px;\">\n    <p style=\"font-weight:600;margin:0 0 8px;font-size:1.05em;\">Easy Financing</p>\n    <p style=\"margin:0;font-size:0.9em;opacity:0.7;line-height:1.6;\">Lease-to-own options from Progressive, Acima, Koalifi (no credit needed), plus 0% interest promos with Synchrony for good credit.</p>\n  </div>\n  <div style=\"text-align:center;padding:20px;border:1px solid #eee;border-radius:6px;\">\n    <p style=\"font-weight:600;margin:0 0 8px;font-size:1.05em;\">Local Delivery</p>\n    <p style=\"margin:0;font-size:0.9em;opacity:0.7;line-height:1.6;\">Delivered to your door within 50 miles of Louisville in 1\u20132 weeks.</p>\n  </div>\n</div>\n\n<h3 style=\"font-size:1.2em;margin:32px 0 12px;\">Furniture Financing in Louisville \u2014 Bad Credit OK</h3>\n<p style=\"line-height:1.7;margin:0 0 16px;\">Bubba's offers more financing options than any other furniture store in Louisville. Whether you have great credit, no credit, or rebuilding credit, we have a plan that works. Start with as little as <strong>$25 down with Acima</strong>, or take advantage of early purchase options. <a href=\"/pages/financing\" style=\"text-decoration:underline;\">See all financing options</a>.</p>\n\n<h3 style=\"font-size:1.2em;margin:32px 0 12px;\">Authorized Ashley Furniture Dealer</h3>\n<p style=\"line-height:1.7;margin:0 0 16px;\">Every piece in our store is brand new from the Ashley Furniture warehouse, complete with manufacturer warranty. We carry the full Ashley lineup at prices below the big-box retailers. Browse our <a href=\"/collections/living-room\" style=\"text-decoration:underline;\">living room</a>, <a href=\"/collections/bedroom\" style=\"text-decoration:underline;\">bedroom</a>, <a href=\"/collections/sleep-bedding\" style=\"text-decoration:underline;\">mattress</a>, and <a href=\"/collections/dining-room\" style=\"text-decoration:underline;\">dining room</a> collections.</p>\n\n<h3 style=\"font-size:1.2em;margin:32px 0 12px;\">Serving Louisville and Surrounding Areas</h3>\n<p style=\"line-height:1.7;margin:0 0 24px;\">We deliver to Louisville, Shively, Valley Station, Pleasure Ridge Park, Okolona, Fairdale, Jeffersontown, Shepherdsville, Radcliff, Elizabethtown, New Albany IN, and Clarksville IN.</p>\n\n<div style=\"text-align:center;padding:24px;background:#f9f7f3;border-radius:8px;margin-top:32px;\">\n  <p style=\"margin:0 0 8px;font-weight:600;\">Visit our showroom</p>\n  <p style=\"margin:0 0 4px;\">5907 Terry Rd, Louisville, KY 40258</p>\n  <p style=\"margin:0;\"><a href=\"tel:+15024940376\" style=\"font-weight:600;color:#111;text-decoration:none;\">(502) 494-0376</a></p>\n</div>\n\n</div>", "color_scheme": "", "padding_top": 40, "padding_bottom": 52}}, "rich_text_xjwBKb": {"type": "rich-text", "blocks": {"heading_YNKtkA": {"type": "heading", "settings": {"heading": "Flexible Financing Available", "heading_size": "h2"}}, "text_LayqJV": {"type": "text", "settings": {"text": "<p>Take home any Ashley Furniture piece today with flexible financing options. No credit check required for most plans. Traditional bank account required for lease-to-own options.</p><p>\ud83d\udcb3\u00a0<strong>Progressive Leasing</strong>\u00a0\u2014 No credit check \u00b7 Flexible payments \ud83d\udcb3\u00a0<strong>Acima</strong>\u00a0\u2014 Lowest initial payment \u00b7 Quick approval \ud83d\udcb3\u00a0<strong>Koalifi</strong>\u00a0\u2014 100 days same as cash \u00b7 Transparent terms \ud83d\udcb3\u00a0<strong>Synchrony</strong>\u00a0\u2014 0% interest promos \u00b7 For good credit</p>"}}, "button_6WaqpB": {"type": "button", "settings": {"button_label": "Apply Now", "button_link": "https://www.bubbasmattressfurniturelouisville.com/pages/financing", "button_style_secondary": false, "button_label_2": "", "button_link_2": "", "button_style_secondary_2": false}}}, "block_order": ["heading_YNKtkA", "text_LayqJV", "button_6WaqpB"], "disabled": true, "name": "t:sections.rich-text.presets.name",