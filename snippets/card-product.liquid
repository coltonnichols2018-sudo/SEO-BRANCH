{% comment %}
  Bubba's product card (rebuilt Sep 2026)
  - Whole product image shown (object-fit: contain, no cropping)
  - Title split: "Midnight-Madness - Sectional - Onyx" -> "Midnight Madness Sectional" + "Onyx"
  - No vendor line, no quick-add button; whole card is the link
  - "HOT BUY" badge only on products in the Colton's Picks — Bestsellers collection
  - Clean price, small "View details" cue

  Accepts: card_product, media_aspect_ratio, show_rating, lazy_load, skip_styles, section_id
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  <style>
    .bb-card{display:flex;flex-direction:column;height:100%;text-decoration:none;color:inherit}
    .bb-card__media{position:relative;background:#fff;border:1px solid #ececec;border-radius:10px;overflow:hidden;aspect-ratio:4/3}
    .bb-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:6px;transition:transform .35s ease}
    .bb-card__media img.bb-card__img--hover{opacity:0;transition:opacity .3s ease}
    @media (hover:hover){
      .bb-card:hover .bb-card__media img{transform:scale(1.03)}
      .bb-card:hover .bb-card__media img.bb-card__img--hover{opacity:1}
    }
    .bb-card__badge{position:absolute;top:10px;left:10px;z-index:2;background:#c0392b;color:#fff;font-size:1.1rem;font-weight:800;letter-spacing:.06em;padding:5px 10px;border-radius:999px;line-height:1;box-shadow:0 2px 8px rgba(192,57,43,.35)}
    .bb-card__badge--hot::before{content:'\1F525';margin-right:4px;font-size:1.05em}
    .bb-card__badge--soldout{background:#555;box-shadow:none}
    .bb-card__body{padding:12px 2px 6px}
    .bb-card__title{margin:0;font-size:1.6rem;line-height:1.3;font-weight:600;color:#111}
    .bb-card__sub{margin:2px 0 0;font-size:1.3rem;color:#666}
    .bb-card__price{margin:8px 0 0;font-size:1.7rem;font-weight:700;color:#111}
    .bb-card__price .price{margin:0}
    .bb-card__price .price-item{font-size:inherit;font-weight:inherit;color:inherit}
    .bb-card__price .price--on-sale .price-item--regular{font-weight:400;color:#888;font-size:1.3rem}
    .bb-card__meta{margin:6px 0 0;font-size:1.25rem;color:#c0392b;font-weight:600}
    .bb-card__cta{margin:8px 0 0;font-size:1.25rem;color:#1a56db;font-weight:600}
    .bb-card .rating{margin-top:6px}
    @media (max-width:749px){
      .bb-card__title{font-size:1.4rem}
      .bb-card__price{font-size:1.5rem}
      .bb-card__badge{font-size:1rem;padding:4px 8px}
    }
  </style>
{%- endunless -%}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign parts = card_product.title | split: ' - '
    assign main_title = card_product.title
    assign sub_title = ''
    if parts.size >= 3
      assign name = parts[0] | replace: '-', ' '
      assign main_title = name | append: ' ' | append: parts[1]
      assign rest = parts | slice: 2, 5
      assign sub_title = rest | join: ' · '
    elsif parts.size == 2
      assign name = parts[0] | replace: '-', ' '
      assign main_title = name | append: ' ' | append: parts[1]
    endif
    assign img_alt = card_product.featured_media.alt | default: card_product.title
    assign is_hot = false
    for c in card_product.collections
      if c.handle == 'coltons-picks-bestsellers'
        assign is_hot = true
        break
      endif
    endfor
  -%}
  <div class="card-wrapper product-card-wrapper">
    <a class="bb-card" href="{{ card_product.url }}" id="CardLink-{{ section_id }}-{{ card_product.id }}">
      <div class="bb-card__media">
        {%- if card_product.available == false -%}
          <span class="bb-card__badge bb-card__badge--soldout">SOLD OUT</span>
        {%- elsif is_hot -%}
          <span class="bb-card__badge bb-card__badge--hot">HOT BUY</span>
        {%- endif -%}
        {%- if card_product.featured_media -%}
          <img
            srcset="{{ card_product.featured_media | image_url: width: 360 }} 360w, {{ card_product.featured_media | image_url: width: 533 }} 533w, {{ card_product.featured_media | image_url: width: 720 }} 720w, {{ card_product.featured_media | image_url: width: 940 }} 940w"
            src="{{ card_product.featured_media | image_url: width: 533 }}"
            sizes="(min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
            alt="{{ img_alt | escape }}"
            {% unless lazy_load == false %}loading="lazy"{% endunless %}
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
          {%- if card_product.media[1] != null -%}
            <img
              class="bb-card__img--hover"
              src="{{ card_product.media[1] | image_url: width: 533 }}"
              alt="{{ card_product.media[1].alt | default: img_alt | escape }}"
              loading="lazy"
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
            >
          {%- endif -%}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="bb-card__body">
        <h3 class="bb-card__title" id="title-{{ section_id }}-{{ card_product.id }}">{{ main_title | escape }}</h3>
        {%- if sub_title != blank -%}
          <p class="bb-card__sub">{{ sub_title | escape }}</p>
        {%- endif -%}
        {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
          {% liquid
            assign rating_decimal = 0
            assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
            if decimal >= 0.3 and decimal <= 0.7
              assign rating_decimal = 0.5
            elsif decimal > 0.7
              assign rating_decimal = 1
            endif
          %}
          <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
            <span aria-hidden="true" class="rating-star" style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
          </div>
        {%- endif -%}
        <div class="bb-card__price">
          {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
        </div>
        {%- if card_product.available -%}
          <p class="bb-card__meta">Payment plans · take it home today</p>
        {%- endif -%}
        <p class="bb-card__cta">View details →</p>
      </div>
    </a>
  </div>
{%- else -%}
  <div class="card-wrapper product-card-wrapper">
    <div class="bb-card">
      <div class="bb-card__media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      <div class="bb-card__body">
        <h3 class="bb-card__title">{{ 'onboarding.product_title' | t }}</h3>
        <div class="bb-card__price">{% render 'price', placeholder: true, show_compare_at_price: true %}</div>
      </div>
    </div>
  </div>
{%- endif -%}
