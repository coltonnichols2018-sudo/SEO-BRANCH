{% comment %}
  SEO Breadcrumb Navigation
  Renders visible breadcrumbs with Schema.org markup

  Usage: {% render 'breadcrumbs' %}
{% endcomment %}

<style>
  .breadcrumbs { padding: 12px 0; font-size: 0.8em; }
  .breadcrumbs__list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .breadcrumbs__item { display: flex; align-items: center; gap: 4px; }
  .breadcrumbs__item:not(:last-child)::after { content: "/"; opacity: 0.5; margin-left: 4px; }
  .breadcrumbs__link { text-decoration: none; opacity: 0.7; }
  .breadcrumbs__link:hover { opacity: 1; text-decoration: underline; }
  .breadcrumbs__current { opacity: 0.9; font-weight: 500; }
</style>

<nav class="breadcrumbs page-width" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" class="breadcrumbs__link" itemprop="item">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1">
    </li>

    {%- if template contains 'product' -%}
      {%- if product.collections.first -%}
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ product.collections.first.url }}" class="breadcrumbs__link" itemprop="item">
            <span itemprop="name">{{ product.collections.first.title | escape }}</span>
          </a>
          <meta itemprop="position" content="2">
        </li>
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="breadcrumbs__current" itemprop="name">{{ product.title | escape }}</span>
          <meta itemprop="item" content="{{ request.origin }}{{ product.url }}">
          <meta itemprop="position" content="3">
        </li>
      {%- else -%}
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="breadcrumbs__current" itemprop="name">{{ product.title | escape }}</span>
          <meta itemprop="item" content="{{ request.origin }}{{ product.url }}">
          <meta itemprop="position" content="2">
        </li>
      {%- endif -%}

    {%- elsif template contains 'collection' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__current" itemprop="name">{{ collection.title | escape }}</span>
        <meta itemprop="item" content="{{ request.origin }}{{ collection.url }}">
        <meta itemprop="position" content="2">
      </li>

    {%- elsif template contains 'article' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ blog.url }}" class="breadcrumbs__link" itemprop="item">
          <span itemprop="name">{{ blog.title | escape }}</span>
        </a>
        <meta itemprop="position" content="2">
      </li>
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__current" itemprop="name">{{ article.title | escape }}</span>
        <meta itemprop="item" content="{{ request.origin }}{{ article.url }}">
        <meta itemprop="position" content="3">
      </li>

    {%- elsif template contains 'blog' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__current" itemprop="name">{{ blog.title | escape }}</span>
        <meta itemprop="item" content="{{ request.origin }}{{ blog.url }}">
        <meta itemprop="position" content="2">
      </li>

    {%- elsif template contains 'page' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__current" itemprop="name">{{ page.title | escape }}</span>
        <meta itemprop="item" content="{{ request.origin }}{{ page.url }}">
        <meta itemprop="position" content="2">
      </li>

    {%- elsif template contains 'search' -%}
      <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="breadcrumbs__current" itemprop="name">Search Results</span>
        <meta itemprop="position" content="2">
      </li>
    {%- endif -%}
  </ol>
</nav>
